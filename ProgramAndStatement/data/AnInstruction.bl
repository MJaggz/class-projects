PROGRAM OneInstruction IS 
  INSTRUCTION AnInstruction IS 
    WHILE next-is-empty DO 
      IF random THEN  
        move 
      ELSE  
        IF random THEN  
          turnleft 
        ELSE  
          turnright 
        END IF 
      END IF 
    END WHILE 
  END AnInstruction 
  
  BEGIN 
    WHILE true DO 
      AnInstruction
      IF next-is-enemy THEN 
        infect 
      ELSE  
        IF random THEN 
          turnleft 
        ELSE 
          turnright 
        END IF 
      END IF 
    END WHILE 
  END OneInstruction
